DISCORD_TOKEN=
# Base de datos MySQL: la misma del servidor de SA-MP (los datos de scriptfiles/srp_db.ini)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Opcional: imágenes de las skins para /samp profile ({skin} = número de skin). Por defecto, las de open.mp
SAMP_SKIN_URL=
# Opcional: imagen de fondo de las tarjetas de bienvenida/despedida (si no, el banner del servidor o un atardecer)
WELCOME_BANNER=
# Opcional: zona horaria de los premios semanales de la Fortuna (domingo 20:00). Por defecto America/Mexico_City
FORTUNA_TZ=
# Tienda Tebex: "Secret Key" de creator.tebex.io -> Webhooks. Sin ella el webhook no se arranca.
TEBEX_WEBHOOK_SECRET=
# Puerto del webhook (si se deja vacío se usa SERVER_PORT del panel). URL para Tebex: http://IP:PUERTO/tebex
TEBEX_PORT=
# Opcional: ID del canal donde se registran las compras (si no, uno que se llame "compras" o "tebex")
TEBEX_LOG_CHANNEL=
GIPHY_TOKEN=
WEBHOOK_ID=
WEBHOOK_TOKEN=
DISCORD_ID=

# Variables opcionales
# Estados del bot separados por ", "
DISCORD_STATUS=
# Invitación a tu servidor de soporte (se usa en los botones y enlaces del bot)
SUPPORT_SERVER=
RADIO=
TOPGG_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Lavalink v4 para la música. Déjalo vacío para usar los nodos públicos de respaldo.
# Si tienes tu propio nodo, pon aquí sus datos (el puerto 443 activa SSL automáticamente).
LAVALINK_HOST=
LAVALINK_PASSWORD=
LAVALINK_PORT=
LAVALINK_SECURE=
# Pon false para usar solo tu nodo, sin los públicos de respaldo
LAVALINK_FALLBACK=true
OPENAI= 
