DISCORD_TOKEN=
# Base de datos MySQL: la misma del servidor de SA-MP (los datos de scriptfiles/srp_db.ini)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Opcional: imágenes de las skins para /samp profile ({skin} = número de skin). Por defecto, las de open.mp
SAMP_SKIN_URL=
# Opcional: imagen de fondo de las tarjetas de bienvenida/despedida (si no, el banner del servidor o un atardecer)
WELCOME_BANNER=
# Opcional: zona horaria de los premios semanales de la Fortuna (domingo 20:00). Por defecto America/Mexico_City
FORTUNA_TZ=

# Cuenta de TikTok cuyos videos nuevos se avisan en el canal 🎵┆tiktok (por defecto sampcity.oficial).
# Creadores (/tiktok add | remove | list, staff): sus videos que etiquetan a esa cuenta salen en el mismo canal.
TIKTOK_USER=sampcity.oficial
# Opcionales: rol a mencionar en los avisos, creadores fijos (coma), 0 = sin aviso de creadores o sin mencionar el rol
# TIKTOK_ROLE_ID=
# TIKTOK_CREATORS=
# TIKTOK_MENTIONS=0
# TIKTOK_MENTIONS_PING=0
GIPHY_TOKEN=
WEBHOOK_ID=
WEBHOOK_TOKEN=
DISCORD_ID=

# Variables opcionales
# Estados del bot separados por ", "
DISCORD_STATUS=
# Invitación a tu servidor de soporte (se usa en los botones y enlaces del bot)
SUPPORT_SERVER=
RADIO=
TOPGG_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Lavalink v4 para la música. Déjalo vacío para usar los nodos públicos de respaldo.
# Si tienes tu propio nodo, pon aquí sus datos (el puerto 443 activa SSL automáticamente).
LAVALINK_HOST=
LAVALINK_PASSWORD=
LAVALINK_PORT=
LAVALINK_SECURE=
# Pon false para usar solo tu nodo, sin los públicos de respaldo
LAVALINK_FALLBACK=true
OPENAI= 

# Copias de seguridad del servidor de Discord (/backup). Se guardan en la base de datos MySQL.
BACKUP_ENABLED=true
# Cada cuántas horas se hace la copia automática
BACKUP_INTERVAL_HOURS=12
# Cuántas copias automáticas se guardan (30 = 15 días). Los mensajes se guardan una sola vez y no se borran.
BACKUP_KEEP=30
# Archivos adjuntos más grandes que esto no se guardan (MB)
BACKUP_MAX_FILE_MB=8
# IDs de Discord (separados por comas) que pueden restaurar y descargar copias, además del dueño del servidor
BACKUP_OWNERS=

# Rangos unificados juego <-> Discord (src/handlers/functions/rangosSync.js, docs/rangos/tabla-rangos.md)
# off = apagado · dry = solo muestra en la consola lo que haría · on = crea los roles y sincroniza
# Decidido el 04-oct-2026: manda el juego (el staff se da en el juego y Discord lo copia) -> on. La primera vez se
# puede poner dry un rato para ver en la consola qué roles va a poner y quitar.
RANGOS_SYNC=on
RANGOS_SYNC_MINUTES=10
RANGOS_GUILD=
# Insignias automáticas: coins compradas en Tebex (solo compras viejas: la tienda se quitó) para ser 💎 USUARIO DIAMANTE, y fechas de la fase beta (AAAA-MM-DD):
# las cuentas creadas entre esas fechas son 🧪 BETA TESTER (sin RANGOS_BETA_DESDE no se da sola; sin HASTA = hasta hoy)
RANGOS_DIAMANTE_COINS=100
RANGOS_BETA_DESDE=
RANGOS_BETA_HASTA=

# Verificación con la cuenta del juego (src/assets/utils/verification.js). La web (/verificar) vincula Discord y el bot
# da el rol de verificado (👤 USUARIO o VERIFY_ROLE) y el apodo del personaje.
# on = quien no está vinculado pierde el rol · suave = da rol y apodo pero no quita a nadie · off = apagada
VERIFICACION=on
# Dirección de la web (para los botones de verificar) e IP del servidor de juego que se muestra en los mensajes
WEB_URL=https://sampcity.app
SAMP_IP=sv.sampcity.app:7781
# Tickets: horas sin mensajes para avisar y para cerrar solo, y horas que tarda en borrarse un ticket cerrado (0 = nunca)
TICKETS_AVISO_H=48
TICKETS_CIERRE_H=72
TICKETS_BORRAR_H=24
